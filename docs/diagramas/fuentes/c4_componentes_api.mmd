        RL["middleware/rateLimit<br/><small>ventana fija por minuto</small>"]
        subgraph R["routes/"]
            RA["auth"]
            RAD["admin"]
            RAN["announcements"]
            RH["helpRequests"]
            RD2["directory"]
            RP["presence"]
        end
        subgraph S["services/"]
            SAN["announcements<br/><small>publicar, listar, estado, confirmar</small>"]
            SH["helpRequests<br/><small>crear, listar, tomar, resolver</small>"]
            SAU["auth<br/><small>login</small>"]
            SAD["campaigns · teams · users<br/><small>administración</small>"]
            SDP["directory · presence<br/><small>consultas del supervisor</small>"]
