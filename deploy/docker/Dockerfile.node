# Una imagen por servicio: WORKSPACE elige cuál (apps/api, apps/gateway, apps/worker o db).
FROM node:26-alpine AS deps
ARG WORKSPACE=apps/api
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/gateway/package.json apps/gateway/
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
COPY db/package.json db/
# Solo dependencias de producción del servicio elegido: la imagen queda más pequeña.
RUN npm ci --omit=dev --no-audit --no-fund --workspace "$WORKSPACE" --include-workspace-root=false

FROM node:26-alpine AS runtime
ARG WORKSPACE=apps/api
ENV NODE_ENV=production
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json
COPY packages/shared ./packages/shared
COPY ${WORKSPACE} ./${WORKSPACE}
# Autoridad certificadora de RDS: permite verificar el certificado de la base en AWS.
ADD --chmod=644 https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem /etc/ssl/rds/global-bundle.pem
WORKDIR /app/${WORKSPACE}
USER node
ENV PORT=3000
EXPOSE 3000
# node directamente: recibe SIGTERM para cerrar limpio y no escribe en disco como npm.
CMD ["node", "src/index.js"]
